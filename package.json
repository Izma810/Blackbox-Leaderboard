{
  "name": "blackbox-leaderboard",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 execute blackbox-leaderboard --file=src/db/schema.sql",
    "db:migrate:remote": "wrangler d1 execute blackbox-leaderboard --remote --file=src/db/schema.sql",
    "cf-typegen": "wrangler types",
    "db:migrate:0002": "wrangler d1 execute blackbox-leaderboard --local --file=src/db/migrations/0002_payouts_and_hints.sql",
    "db:migrate:0002:remote": "wrangler d1 execute blackbox-leaderboard --remote --file=src/db/migrations/0002_payouts_and_hints.sql"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241022.0",
    "typescript": "^5.5.0",
    "wrangler": "^3.78.0"
  }
}
